# Jio frontend environment
# Copy to frontend/.env for local development: cp .env.example .env
#
# EVERYTHING HERE IS PUBLIC. Vite inlines every VITE_* variable into the
# JavaScript bundle, so anyone can read these values in devtools.
# Never put a secret, password or service-role key in this file.

# ── Supabase (browser client: auth, CRUD under RLS, realtime) ──
# Supabase dashboard → Project Settings → API
# Use the "jio" project here. The "jio-test" project is for Playwright only.
VITE_SUPABASE_URL=
# The anon key, or the newer publishable key (sb_publishable_...). Safe to expose; RLS protects the data.
VITE_SUPABASE_ANON_KEY=

# ── Jio backend (planner, geocode and weather proxy) ──
# Development: leave blank. The Vite dev server forwards /api to the backend on port 3000, which also works in
# a GitHub codespace. Deployed: the Render service URL, no trailing slash.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=https://jio-api.onrender.com
# Development only: where the Vite dev server forwards /api when VITE_API_BASE_URL is blank. Read by vite.config.js
# from the shell, not from this file, so set it on the command line if the backend is not on port 3000:
#   JIO_BACKEND_URL=http://localhost:3100 pnpm dev:frontend

# ── Local accounts in a production build ──
# A production build with no Supabase settings above shows "Jio is not available right now" and nothing else, and a
# production build WITH them ignores any account that lives only in the browser (a leftover demo save). Set this to 1 at
# build time to keep browser-only accounts working in a production build, for a deployed demo that has no Supabase
# project. Development builds always keep the demo account. Leave it blank for a real deployment.
VITE_ALLOW_LOCAL_ACCOUNTS=

# ── Demo tour in a production build ──
# Set to 1 at build time to put the guided demo in the build: /demo makes the demo account, loads one outing saved at eight
# checkpoints (just created, invites out, sharing locations, choosing the spot, voting on places, plan confirmed, on the day,
# finished with photos) and a few side cases, and shows a strip at the top of every screen to move between them. Labelled as
# sample data. It works with the backend asleep or off, answering with rough stand-in places and times.
# It REQUIRES VITE_ALLOW_LOCAL_ACCOUNTS=1 above (the demo account lives in the browser). A build with this and without that
# refuses to start and says why in the console. Without this flag the tour is not in the bundle at all and /demo is the
# "not found" page. Development builds always have the tour. Leave it blank for a real deployment.
VITE_DEMO_TOUR=

# ── Demo tools in a production build ──
# Set to 1 at build time to put the demo tools in the build: the Demo panel (showcase sessions, the rain switch and the other
# demo controls) and the demo sign-in buttons on sign-up. Anyone with the link can use them, in their own browser. The made-up
# real account stays out: it is development only. It REQUIRES VITE_ALLOW_LOCAL_ACCOUNTS=1 above; a build with this and without
# that refuses to start and says why in the console. Development builds always have them. Leave it blank for a real deployment.
VITE_DEMO_TOOLS=
