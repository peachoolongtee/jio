# Jio frontend environment
# Copy to frontend/.env for local development: cp .env.example .env
#
# EVERYTHING HERE IS PUBLIC. Vite inlines every VITE_* variable into the
# JavaScript bundle, so anyone can read these values in devtools.
# Never put a secret, password or service-role key in this file.

# ── Supabase (browser client: auth, CRUD under RLS, realtime) ──
# Supabase dashboard → Project Settings → API
# Use the "jio" project here. The "jio-test" project is for Playwright only.
VITE_SUPABASE_URL=
# The anon key, or the newer publishable key (sb_publishable_...). Safe to expose; RLS protects the data.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtwbHpiamtsZnR2c3ZoYWltZGFmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzMjg3NzMsImV4cCI6MjEwNDkwNDc3M30.jPTebiEF00WtNRoMcRPO7jroHrBmKC5zYIJIcXstWIY

# ── Jio backend (planner, geocode and weather proxy) ──
# Development: leave blank. The Vite dev server forwards /api to the backend on port 3000, which also works in
# a GitHub codespace. Deployed: the Render service URL, no trailing slash.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=https://jio-api.onrender.com

# ── Local accounts in a production build ──
# A production build with no Supabase settings above shows "Jio is not available right now" and nothing else, and a
# production build WITH them ignores any account that lives only in the browser (a leftover demo save). Set this to 1 at
# build time to keep browser-only accounts working in a production build, for a deployed demo that has no Supabase
# project. Development builds always keep the demo account. Leave it blank for a real deployment.
VITE_ALLOW_LOCAL_ACCOUNTS=
