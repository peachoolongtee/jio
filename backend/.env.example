# Jio backend environment
# Copy to backend/.env for local development: cp .env.example .env
#
# EVERYTHING HERE IS SECRET. This file's real copy is never committed and
# its values never reach the browser. Every keyed external API call goes
# through this server so these credentials stay contained.
# On Render, set these under the service's Environment tab instead.

# ── Server ──
PORT=3000
# The only origin CORS allows. Never "*".
# Local: the Vite dev server. Deployed: the Vercel URL, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_ORIGIN=https://jio.vercel.app

# ── Stub mode (tests and offline work only) ──
# Set to 1 to answer OneMap, data.gov.sg and LTA calls from the fixture files
# in backend/tests/fixtures/ instead of the network. Playwright runs need it.
# Leave it blank for normal development. The server refuses to start with it
# on in production.
STUB_EXTERNALS=

# ── Supabase (server-side access with the service role) ──
# Supabase dashboard → Project Settings → API
# Point at "jio" for development and the demo, at "jio-test" when running Playwright.
SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key. Public, the same value as the frontend's VITE_SUPABASE_ANON_KEY. The server uses it to
# act as the signed-in user, so the database's row-level security decides what that user can see.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# The service_role key, or the newer secret key (sb_secret_...).
# It bypasses Row Level Security: server only, never the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
# Set to 1 only if login checks answer "sign in again" for users who are signed in, and the server log says
# it refused a legacy (HS256) token. That means the project still signs tokens with the old shared secret.
SUPABASE_ALLOW_LEGACY_TOKENS=

# ── OneMap (Singapore Land Authority): routing, search, themes ──
# Register at https://www.onemap.gov.sg/apidocs/register
# The server exchanges these for a token that lasts 72 hours and refreshes it itself.
# Address search works without them. Public transport routing needs them: until they are set (the example
# values below count as not set), travel times are the planner's own estimate. Set both or neither: the server
# refuses to start with only one of them.
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-onemap-password
# The most calls this server makes to OneMap in a minute, routing, search and login together. The OneMap
# account is shared and allows 300 a minute, so the default of 240 leaves room. Blank means 240. A routing trip
# over the budget uses the planner's estimate; an address search answers 503 with Retry-After.
ONEMAP_CALLS_PER_MINUTE=

# ── LTA DataMall: MRT crowd density (v2 only, can stay blank for v1) ──
# Request at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# ── Google Places (New): restaurants, cafés and bars with ratings, prices and hours ──
# A Maps Demo Key (https://mapsplatform.google.com/maps-demo-key/) works for development, without photos.
# For the deployed app: a key from a Google Cloud project, restricted to Places API (New), with a daily quota cap.
# Leave blank to switch Google off: the planner then uses its other venues. A value with a space or a control
# character inside it counts as not set, and the server warns at start-up without printing it.
GOOGLE_MAPS_API_KEY=
# The most calls this server makes to Google in a minute, nearby searches and photos together. Blank means 60.
# A call over the cap is not made: the planner answers without Google, and the photo route answers 503.
# Three failures in a row pause Google for a minute; each call waits at most 3 seconds.
GOOGLE_CALLS_PER_MINUTE=

# The AI order of a plan, suggested when the group confirms: it puts the drink, shop and activity stops in the nicest
# order while food stays at meal times. Gemini is used when GEMINI_API_KEY is set (free tier: a key from
# aistudio.google.com), else Claude when ANTHROPIC_API_KEY is set (console.anthropic.com). Leave both blank to switch
# it off: the plan then gets the order the rules score best (travel and waiting). A key is trimmed; one with a space, a
# control character or a character outside plain ASCII counts as not set, and the server warns at start-up without
# printing it. Never commit a real key.
GEMINI_API_KEY=
# Gemini's model. Blank means gemini-3.8-flash. The names were not checked against the live API: a model the service
# rejects means the rules order and one log line.
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Claude's model. Blank means claude-haiku-5-5 (small and cheap: it only picks one number and writes one sentence).
# Same warning as above about the name.
ANTHROPIC_MODEL=
# The most AI calls this server makes in a minute, Gemini and Claude together. Blank means 20. A request over the cap
# is answered by the rules at once. Also: at most 2 calls at once, three failures in a row pause the AI for a minute,
# an answer is kept for 10 minutes, and a call takes at most 8 seconds. Set a spend limit in the provider's console too.
ITINERARY_AI_CALLS_PER_MINUTE=

# ── Saved places from a post link (optional, OFF unless LINK_READER=1) ──
# Reads a pasted YouTube, TikTok, Instagram or Xiaohongshu link and lists the places in it (docs/link-reader-api.md).
# It is a paid, video-fetching feature, so it has a switch of its own: set LINK_READER=1 to turn it on. Without it the three
# /api/links routes do not exist (they answer 404 like any unknown address) and nothing about it runs at start-up.
LINK_READER=
# It also needs GEMINI_API_KEY above (the same key as the itinerary AI, so both draw on one provider quota). With LINK_READER=1
# and no key, reading and refreshing answer 503. Gemini opens a public YouTube video itself.
# YouTube Data API key: adds the video's description and date. Blank means GOOGLE_MAPS_API_KEY is used, which works when
# "YouTube Data API v3" is enabled on its Google Cloud project and the key's restrictions allow it. With neither, the video is
# still read, without those.
YOUTUBE_API_KEY=
# Set to 1 to also read a YouTube post's top comments and send them to the AI (names and @handles are taken out). Off by default:
# comments are by strangers, and only venue names, kinds, times and the weather go to an AI provider until the team lead decides.
LINK_READER_COMMENTS=
# Gemini's model for reading videos. Blank means gemini-3.5-flash-lite.
GEMINI_VIDEO_MODEL=
# The most AI calls a minute for the whole server, one for each model tried (a read can try three). Blank means 6.
LINK_READER_CALLS_PER_MINUTE=
# The most reads, and separately the most refreshes, one caller may make a minute. Blank means 3.
LINK_READER_PER_CALLER_PER_MINUTE=
# The link reader may spend at most a third of GOOGLE_CALLS_PER_MINUTE on its Google matches, whatever else is set.
# Development tools, for your own laptop only: they need NODE_ENV=development as well as their own variable, and are ignored
# otherwise. Set to 1 to download TikTok and Instagram videos with yt-dlp (brew install yt-dlp). Those sites' terms do not allow it.
LINK_READER_YTDLP=
# Set to 1 to open TikTok photo posts, Instagram posts and Xiaohongshu in headless Chrome and read their slides (needs Google
# Chrome installed; Playwright comes with the frontend's dev dependencies). Same warning: development laptops only.
LINK_READER_BROWSER=
# The path of Chrome, only if it is not in the usual place.
LINK_READER_CHROME=

# ── data.gov.sg weather (optional) ──
# The weather API needs no key. Without one it allows 6 requests per 10 seconds.
# A key raises that limit. Leave blank unless the limit is hit.
# DATAGOV_API_KEY=

# ── Simulated forecast (demos only) ──
# The planner scores venues against the live two-hour forecast from data.gov.sg. Set to 1 to let a request
# send weatherCase ("clear" or "rain") to fake the forecast, for example to show rain on a dry day. The
# response then says weather.source is "simulated". Without it, weatherCase is ignored, the real forecast
# is used, and the response says weather.simulationIgnored. Stub mode (STUB_EXTERNALS=1) always allows it.
# Set it to 1 on your own machine if you use the demo panel's rain switch. Leave blank on the deployed app.
ALLOW_SIMULATED_WEATHER=

# How many planner requests one caller may make each minute. Blank means 300. Stub mode has no limit.
PLANNER_RATE_LIMIT_PER_MINUTE=

# Development/demo only: include invented venues and sample visit history from mock-data.json.
# The backend's tests turn this on in vitest.config.js; NODE_ENV does not change it. Leave blank for real venue results.
INCLUDE_FICTIONAL_VENUES=

# How many times one signed-in person may leave a session or remove a guest each minute. Blank means 30. Stub mode has no limit.
SESSION_RATE_LIMIT_PER_MINUTE=

# How many times one signed-in person may search for someone to invite each minute (GET /api/people/search). Blank means 120. Stub mode has no limit.
PEOPLE_SEARCH_RATE_LIMIT_PER_MINUTE=
