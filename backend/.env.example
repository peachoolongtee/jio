# Jio backend environment
# Copy to backend/.env for local development: cp .env.example .env
#
# EVERYTHING HERE IS SECRET. This file's real copy is never committed and
# its values never reach the browser. Every keyed external API call goes
# through this server so these credentials stay contained.
# On Render, set these under the service's Environment tab instead.

# ── Server ──
PORT=3000
# The only origin CORS allows. Never "*".
# Local: the Vite dev server. Deployed: the Vercel URL, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_ORIGIN=https://jio.vercel.app

# ── Stub mode (tests and offline work only) ──
# Set to 1 to answer OneMap, data.gov.sg and LTA calls from the fixture files
# in backend/tests/fixtures/ instead of the network. Playwright runs need it.
# Leave it blank for normal development. The server refuses to start with it
# on in production.
STUB_EXTERNALS=

# ── Supabase (server-side access with the service role) ──
# Supabase dashboard → Project Settings → API
# Point at "jio" for development and the demo, at "jio-test" when running Playwright.
SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key. Public, the same value as the frontend's VITE_SUPABASE_ANON_KEY. The server uses it to
# act as the signed-in user, so the database's row-level security decides what that user can see.
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# The service_role key, or the newer secret key (sb_secret_...).
# It bypasses Row Level Security: server only, never the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
# Set to 1 only if login checks answer "sign in again" for users who are signed in, and the server log says
# it refused a legacy (HS256) token. That means the project still signs tokens with the old shared secret.
SUPABASE_ALLOW_LEGACY_TOKENS=

# ── OneMap (Singapore Land Authority): routing, search, themes ──
# Register at https://www.onemap.gov.sg/apidocs/register
# The server exchanges these for a token that lasts 72 hours and refreshes it itself.
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-onemap-password

# ── LTA DataMall: MRT crowd density (v2 only, can stay blank for v1) ──
# Request at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# ── data.gov.sg weather (optional) ──
# The weather API needs no key. Without one it allows 6 requests per 10 seconds.
# A key raises that limit. Leave blank unless the limit is hit.
# DATAGOV_API_KEY=
